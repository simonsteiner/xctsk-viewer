# Environment variables read by the app. Nothing loads this file automatically:
# export the variables in your shell, or set them as Fly.io secrets in production
# (see docs/deployment.md).

# Signs the session cookie that carries flash messages. Required in production;
# when unset, create_app() falls back to an insecure placeholder that is fine
# for local development.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
